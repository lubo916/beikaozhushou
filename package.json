{
  "name": "exam-prep",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e:smoke": "playwright test e2e/smoke",
    "spec:check": "python3 scripts/spec_tool.py check",
    "spec:gen": "python3 scripts/spec_tool.py gen"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0"
  }
}
