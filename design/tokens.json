{
  "$description": "设计令牌（DTCG）。取自原型的配色、字体与圆角（分期规划 0.1c）；主题用 tokens.resolver.json 表达。",
  "color": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "#EEF1F5"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "sunk": {
        "$type": "color",
        "$value": "#F5F7FA"
      }
    },
    "ink": {
      "primary": {
        "$type": "color",
        "$value": "#1A2130"
      },
      "secondary": {
        "$type": "color",
        "$value": "#465064"
      },
      "tertiary": {
        "$type": "color",
        "$value": "#687287"
      }
    },
    "line": {
      "strong": {
        "$type": "color",
        "$value": "#D9DEE6"
      },
      "soft": {
        "$type": "color",
        "$value": "#E8ECF1"
      }
    },
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#2E4A8E"
      },
      "primary-ink": {
        "$type": "color",
        "$value": "#1F3366"
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#E6EBF6"
      }
    },
    "status": {
      "warning": {
        "$type": "color",
        "$value": "#9A6206"
      },
      "warning-soft": {
        "$type": "color",
        "$value": "#FBF0D9"
      },
      "warning-line": {
        "$type": "color",
        "$value": "#E5C78A"
      },
      "danger": {
        "$type": "color",
        "$value": "#B23E2E"
      },
      "danger-soft": {
        "$type": "color",
        "$value": "#FBE7E3"
      },
      "success": {
        "$type": "color",
        "$value": "#23775A"
      },
      "success-soft": {
        "$type": "color",
        "$value": "#DFF0E8"
      },
      "ai": {
        "$type": "color",
        "$value": "#5E4497"
      },
      "ai-soft": {
        "$type": "color",
        "$value": "#EEE9F7"
      }
    },
    "mastery": {
      "0": {
        "$type": "color",
        "$value": "#E3E7EC"
      },
      "1": {
        "$type": "color",
        "$value": "#D2EBE1"
      },
      "2": {
        "$type": "color",
        "$value": "#A9D8C5"
      },
      "3": {
        "$type": "color",
        "$value": "#72BC9F"
      },
      "4": {
        "$type": "color",
        "$value": "#35957A"
      },
      "5": {
        "$type": "color",
        "$value": "#18664F"
      },
      "$description": "六档掌握着色：0 未学 … 5 能迁移（glossary 掌握档）"
    }
  },
  "radius": {
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 7,
        "unit": "px"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "HarmonyOS Sans SC",
          "PingFang SC",
          "Microsoft YaHei",
          "Noto Sans SC",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ]
      },
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Songti SC",
          "Noto Serif SC",
          "Source Han Serif SC",
          "STSong",
          "SimSun",
          "serif"
        ]
      }
    },
    "size": {
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "small": {
        "$type": "dimension",
        "$value": {
          "value": 12.5,
          "unit": "px"
        }
      },
      "title": {
        "$type": "dimension",
        "$value": {
          "value": 22,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "body": {
        "$type": "number",
        "$value": 1.6
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "size": {
    "breakpoint": {
      "tablet": {
        "$type": "dimension",
        "$value": {
          "value": 700,
          "unit": "px"
        },
        "$description": "外壳容器宽度不小于此值为平板布局（图标栏）；小于此值为手机布局（抽屉与底部五个入口）"
      },
      "desktop": {
        "$type": "dimension",
        "$value": {
          "value": 1024,
          "unit": "px"
        },
        "$description": "外壳容器宽度不小于此值为桌面布局（侧栏）"
      },
      "content-md": {
        "$type": "dimension",
        "$value": {
          "value": 860,
          "unit": "px"
        },
        "$description": "局部：内容区多栏在此宽度以下折叠"
      },
      "content-lg": {
        "$type": "dimension",
        "$value": {
          "value": 1180,
          "unit": "px"
        },
        "$description": "局部：内容区宽屏布局的起点"
      }
    },
    "space": {
      "$description": "间距阶梯（4px 基数）。原型 :root 没有间距变量，F03 按用户拍板补齐：组件 CSS 用 var(--size-space-N)，页面用 Tailwind 的 p-N、gap-N 等，同一个 N 同一个值。",
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "10": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "12": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        }
      }
    },
    "stroke": {
      "$description": "线宽：分隔线与描边用 thin，焦点框与强调线用 thick（组件样式里不写像素字面量）。",
      "thin": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "thick": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    },
    "viewport": {
      "min": {
        "$type": "dimension",
        "$value": {
          "value": 375,
          "unit": "px"
        },
        "$description": "最小支持宽度，手机截图宽度"
      },
      "tablet": {
        "$type": "dimension",
        "$value": {
          "value": 834,
          "unit": "px"
        },
        "$description": "平板截图与验收宽度（ui-rules 第 2 节）"
      },
      "desktop": {
        "$type": "dimension",
        "$value": {
          "value": 1280,
          "unit": "px"
        },
        "$description": "桌面截图与验收宽度（ui-rules 第 2 节）"
      }
    }
  }
}
