{
  "$description": "基础令牌取 tokens.json；叠加顺序 scheme→brand→vision→text。0.1只编译brand=platform，org含未来运行时绑定，排除该上下文；vision别名在当前scheme叠加后解析。",
  "version": "2025.10",
  "sets": [
    {
      "sources": [
        {
          "$ref": "tokens.json"
        }
      ]
    }
  ],
  "modifiers": [
    {
      "name": "scheme",
      "default": "light",
      "contexts": {
        "light": [],
        "dark": [
          {
            "color": {
              "bg": {
                "canvas": {
                  "$type": "color",
                  "$value": "#101724"
                },
                "surface": {
                  "$type": "color",
                  "$value": "#182235"
                },
                "sunk": {
                  "$type": "color",
                  "$value": "#121C2C"
                }
              },
              "ink": {
                "primary": {
                  "$type": "color",
                  "$value": "#F2F5FA"
                },
                "secondary": {
                  "$type": "color",
                  "$value": "#C4CDDC"
                },
                "tertiary": {
                  "$type": "color",
                  "$value": "#A5B1C4"
                },
                "on-brand": {
                  "$type": "color",
                  "$value": "#101724"
                }
              },
              "line": {
                "strong": {
                  "$type": "color",
                  "$value": "#70819A"
                },
                "soft": {
                  "$type": "color",
                  "$value": "#324158"
                }
              },
              "brand": {
                "primary": {
                  "$type": "color",
                  "$value": "#93B4FF"
                },
                "primary-ink": {
                  "$type": "color",
                  "$value": "#CADBFF"
                },
                "primary-soft": {
                  "$type": "color",
                  "$value": "#22375E"
                }
              },
              "status": {
                "warning": {
                  "$type": "color",
                  "$value": "#FFD080"
                },
                "warning-soft": {
                  "$type": "color",
                  "$value": "#49331A"
                },
                "warning-line": {
                  "$type": "color",
                  "$value": "#C9A366"
                },
                "danger": {
                  "$type": "color",
                  "$value": "#FFACA0"
                },
                "danger-soft": {
                  "$type": "color",
                  "$value": "#492C32"
                },
                "success": {
                  "$type": "color",
                  "$value": "#84D6B2"
                },
                "success-soft": {
                  "$type": "color",
                  "$value": "#193F37"
                },
                "ai": {
                  "$type": "color",
                  "$value": "#CEB5FF"
                },
                "ai-soft": {
                  "$type": "color",
                  "$value": "#34274F"
                }
              },
              "cvd": {
                "success": {
                  "$type": "color",
                  "$value": "#9BCBFF"
                },
                "success-soft": {
                  "$type": "color",
                  "$value": "#1D3550"
                },
                "danger": {
                  "$type": "color",
                  "$value": "#FFC37A"
                },
                "danger-soft": {
                  "$type": "color",
                  "$value": "#49331A"
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "brand",
      "default": "platform",
      "contexts": {
        "platform": [],
        "org": [
          {
            "color": {
              "brand": {
                "primary": {
                  "$type": "color",
                  "$value": "{org.brand.primary}"
                },
                "primary-ink": {
                  "$type": "color",
                  "$value": "{org.brand.primary-ink}"
                }
              }
            },
            "$description": "机构白标：主色由机构配置（O14），AI 生成标识与“技术支持”不可移除"
          }
        ]
      }
    },
    {
      "name": "vision",
      "default": "default",
      "contexts": {
        "default": [],
        "cvd": [
          {
            "color": {
              "status": {
                "success": {
                  "$type": "color",
                  "$value": "{color.cvd.success}"
                },
                "success-soft": {
                  "$type": "color",
                  "$value": "{color.cvd.success-soft}"
                },
                "danger": {
                  "$type": "color",
                  "$value": "{color.cvd.danger}"
                },
                "danger-soft": {
                  "$type": "color",
                  "$value": "{color.cvd.danger-soft}"
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "text",
      "default": "default",
      "contexts": {
        "default": [],
        "large": [
          {
            "font": {
              "size": {
                "body": {
                  "$type": "dimension",
                  "$value": {
                    "value": 17,
                    "unit": "px"
                  }
                },
                "small": {
                  "$type": "dimension",
                  "$value": {
                    "value": 15,
                    "unit": "px"
                  }
                },
                "title": {
                  "$type": "dimension",
                  "$value": {
                    "value": 26,
                    "unit": "px"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
