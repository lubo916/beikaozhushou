{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/exam-profile.schema.json",
  "title": "考试画像",
  "description": "考试差异只进这份数据或 docs/product/variation-points.md 登记的扩展点（INV-26）。四个演示考试见 fixtures/exams/。",
  "type": "object",
  "required": ["exam_id", "name", "kind", "evaluation_rule", "full_score", "structure", "question_types", "scoring", "key_dates", "readiness"],
  "additionalProperties": false,
  "properties": {
    "exam_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"},
    "name": {"type": "string", "minLength": 2},
    "short_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "kind": {"enum": ["official", "template", "custom"]},
    "evaluation_rule": {
      "type": "object",
      "required": ["type", "description"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["pass_line", "selective", "score_band", "custom"]},
        "description": {"type": "string"},
        "pass_line": {"type": ["number", "null"]},
        "per_subject": {"type": "boolean"},
        "bands": {"type": "array", "items": {"type": "object", "required": ["label", "min"], "properties": {"label": {"type": "string"}, "min": {"type": "number"}}}}
      }
    },
    "full_score": {"type": "number", "minimum": 1},
    "structure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
    "question_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question_type"}},
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_default": {"type": ["number", "null"]},
        "target_basis": {"type": "string"},
        "rubrics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "duration_minutes": {"type": ["integer", "null"], "minimum": 1},
    "key_dates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/key_date"}},
    "readiness": {
      "type": "object",
      "required": ["map", "questions", "exam_intel"],
      "additionalProperties": false,
      "properties": {
        "map": {"$ref": "#/$defs/readiness_item"},
        "questions": {"$ref": "#/$defs/readiness_item"},
        "exam_intel": {"$ref": "#/$defs/readiness_item"}
      }
    },
    "variation_extensions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["subject", "sections"],
      "additionalProperties": false,
      "properties": {
        "subject": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      }
    },
    "section": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "knowledge_point_count": {"type": "integer", "minimum": 0},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      }
    },
    "question_type": {
      "type": "object",
      "required": ["type", "label", "response_form"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["single_choice", "multi_choice", "true_false", "indefinite_choice", "choice", "fill_blank", "discrimination", "short_answer", "material_analysis", "writing", "translation", "listening", "reading", "calculation", "algorithm_design", "case_analysis", "oral", "practical"]},
        "label": {"type": "string"},
        "response_form": {"enum": ["choice", "fill", "match_order", "stepwise", "written", "material", "listening", "oral", "practical_self"]},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "subjective": {"type": "boolean"}
      }
    },
    "key_date": {
      "type": "object",
      "required": ["kind", "date", "status"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["registration_open", "registration_close", "exam", "score_release", "target"]},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "status": {"enum": ["official", "estimated", "custom"]},
        "basis": {"type": "string"}
      }
    },
    "readiness_item": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 3},
        "note": {"type": "string"}
      }
    }
  }
}
