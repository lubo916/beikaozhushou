{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exam-prep:metrics:phase0-fixture:0.1",
  "title": "METR-01 0 期隔离夹具结构",
  "description": "仅模拟验证结构；引用、状态/集合一致性、时间/时区历法与 not_ready 传播按 ../phase0-contract.md，不作为 learner/plan 生产契约。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "simulated",
    "exam_id",
    "learners"
  ],
  "properties": {
    "fixtureVersion": {
      "const": "0.1"
    },
    "simulated": {
      "const": true
    },
    "exam_id": {
      "type": "string",
      "minLength": 1
    },
    "learners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learner"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!.*-00:00$)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timezone",
        "days"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "learning": {
          "$ref": "#/$defs/learning"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "segments",
        "evidence"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "segment_id",
        "occurred_at",
        "recorded_at",
        "accepted",
        "revoked",
        "strength"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "segment_id": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "accepted": {
          "type": "boolean"
        },
        "revoked": {
          "type": "boolean"
        },
        "strength": {
          "enum": [
            "strong",
            "medium",
            "weak",
            "negative",
            "pending"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedSnapshotId",
        "snapshots"
      ],
      "properties": {
        "selectedSnapshotId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "as_of",
        "today",
        "consolidate"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "today": {
          "$ref": "#/$defs/planSegment"
        },
        "consolidate": {
          "$ref": "#/$defs/planSegment"
        }
      }
    },
    "planSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "eligibleItemIds",
        "completedItemIds"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planItem"
          }
        },
        "eligibleItemIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "completedItemIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "exclusion_reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "seen",
            "unfinished",
            "excluded"
          ]
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
