# 环境变量清单：只写变量名与说明，不含取值。本地复制为 .env 后按说明填写；预发填在 ECS 部署目录的 .env；.env 不进仓库。
# 本机开发的连接串写法见 README“本地开发”。

# 运行环境名：development、test、staging、production。不设置按 development，其他值拒绝启动；
# 正式登录接入前 production 拒绝启动。预发填 staging。
EXAM_PREP_ENV=

# PostgreSQL 连接串（应用、迁移与种子）。本地数据库用 docker compose -f deploy/compose.dev.yml up -d 起；
# 网页沙箱由 tools/sandbox-db.sh 写进 .env.local（不提交）。预发为 RDS PostgreSQL 17 的内网地址。
DATABASE_URL=
# 数据库测试专用的连接串（清表只发生在这个库，不要指向开发库）。本地 compose 已建 exam_prep_test 库。
TEST_DATABASE_URL=
# Redis 连接串（队列、限流与租约）。预发由 compose.staging.yaml 指向容器内的 redis，不必填写。
REDIS_URL=

# API 监听地址与端口（默认 0.0.0.0 与 3000）。
API_HOST=
API_PORT=
# worker 健康检查端口（默认 3001）。
WORKER_HEALTH_PORT=
# 日志级别（默认 info）。
LOG_LEVEL=

# 固定开发者身份（0 期不做正式登录，每个请求都用这个身份；浏览器不能切换）。留空时取种子写入的账号：
# 平台默认租户 01920000-0000-7000-8000-000000000001；学员 01920000-0000-7000-8000-000000000002；
# 游客 01920000-0000-7000-8000-000000000003（角色为 guest 且未填学员 ID 时使用）。见 packages/db/src/fixed-ids.ts。
EXAM_PREP_DEV_TENANT_ID=
EXAM_PREP_DEV_LEARNER_ID=
# 角色：learner 或 guest（默认 learner；guest 由角色推出）。
EXAM_PREP_DEV_ROLE=
# 学员时区（IANA 名称，默认 Asia/Shanghai）。
EXAM_PREP_DEV_TIMEZONE=

# 以下只在预发服务器（ECS 部署目录的 .env）填写，供 compose.staging.yaml 与 release.sh 使用。
# 镜像仓库地址与命名空间（阿里云 ACR）。
ACR_REGISTRY=
ACR_NAMESPACE=
# Caddy 的站点地址：ICP 备案完成前留空（默认 :80，经公网 IP 以 HTTP 访问）；有备案域名后填域名。
EXAM_PREP_SITE_ADDRESS=
# 发布前数据库备份保留的份数（默认 10）。
BACKUP_KEEP=
